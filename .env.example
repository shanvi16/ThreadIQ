# ThreadIQ environment for Docker Compose.  Copy to `.env` (optional - every value has a default).
#   cp .env.example .env

# --- Docker Compose (host-published ports) -----------------------------------------------------
WEB_PORT=5173
CATALOG_PORT=3001
INSIGHTS_PORT=3002

# Origins allowed by CORS on both services (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=info

# --- Browser-facing API URLs, baked into the web build ------------------------------------------
# These are opened by the BROWSER on your machine, so they use localhost + the published ports.
# Never put a container hostname (catalog-service, mongo, ...) here. Rebuild after changing:
#   docker compose up --build -d web
VITE_CATALOG_API_URL=http://localhost:3001
VITE_INSIGHTS_API_URL=http://localhost:3002

# Container-to-container wiring (MONGODB_URI, CATALOG_SERVICE_URL=http://catalog-service:3001) is
# defined in docker-compose.yml using service DNS names. For running WITHOUT Docker see the
# .env.example files inside services/catalog-service, services/insights-service and apps/web.
